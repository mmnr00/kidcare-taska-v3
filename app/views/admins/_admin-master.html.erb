<div class="table-responsive">
    <table class="table table-striped table-bordered" width="100%" cellspacing="0">
      <thead>
        <tr>
          <th style="background-color:#d8b2d8"> ID </th>
          <th style="background-color:#d8b2d8"> NAME </th>
          <th style="background-color:#d8b2d8"> EXPIRY DATE </th>
          <th style="background-color:#d8b2d8"> ADMIN </th>
          <th style="background-color:#d8b2d8"> COLLECTION ID </th>
        </tr>
      </thead>
      <tbody>
        
        

        <% @admin_taska.order('created_at DESC').each do |tsk|%>
          <% if (tsk.expire.to_date - Date.today).to_i > -15 %>
            
            <tr style="background-color:">
              <td><%= tsk.id %></td>
              <td>
                <%= link_to "#{tsk.name}", taska_path(tsk), target: "_blank" %><br>
                <%= link_to "EDIT", edit_taska_path(tsk, plan: tsk.plan), class: "btn btn-sm btn-success", target: "_blank" %>
                <%= link_to "DELETE", taska_path(tsk), class: "btn btn-sm btn-danger", method: :delete,:data => {:confirm => 'Are you sure? This action cant be reversed.'} %>
              </td>
              <td>
                <%= form_tag updtskexpiry_path, method: :get do %> 
                  <%= date_field_tag :dtexp, tsk.expire.to_date,
                            placeholder: "Example: 01162801556",
                            class: "form-control search-box",
                            style: "font-size: 12px"%>
                  <%= hidden_field_tag :id, tsk.id %>
                  <div class="col-md-0">
                    <%= button_tag(type: :submit, class: "badge badge-secondary badge-pill",style: "font-size: 10px", id: "submit_expense") do %>
                      <i class="fa fa-check"></i> UPDATE
                    <% end %>
                  </div>
                    
                <% end %>
                
              </td>
              <td><%= tsk.supervisor %><br>
                <%= "#{tsk.phone_1}-#{tsk.phone_2}" %><br>
                <%= tsk.email %>
              </td>
              <td>
                  <%= form_tag updtskcollection_path, method: :get do %> 
                        ID1 = <%= tsk.collection_name1 %><br>
                        <%= text_field_tag :id1, tsk.collection_id,
                            placeholder: "Example: 01162801556",
                            class: "form-control search-box",
                            style: "font-size: 12px"%>
                        ID2 = <%= tsk.collection_name2 %><br>
                         <%= text_field_tag :id2, tsk.collection_id2,
                            placeholder: "Example: 01162801556",
                            class: "form-control search-box",
                            style: "font-size: 12px"%>  
                        <%= hidden_field_tag :id, tsk.id %>
                      
                      <div class="col-md-0">
                        <%= button_tag(type: :submit, class: "badge badge-secondary badge-pill",style: "font-size: 10px", id: "submit_expense") do %>
                          <i class="fa fa-check"></i> UPDATE
                        <% end %>
                      </div>
                    
                  <% end %>
              </td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>