
<div class="col-12" style="margin-left: 0px;margin-top: 10px;margin-right: 0px;">
  <div class="table table-responsive border" style="font-size:12px">
    <table class="table table-bordered table-striped shadow" id="dataTable" width="100%" cellspacing="0">
      <thead>
        <tr class="shadow">
          <th style="background-color:#7f7fff; width: 20%; text-align: center" colspan="3">REKOD PENILAIAN PELAJAR PEMANTAUAN </th>
        </tr>
      </thead>
      <thead>
        <tr class="shadow">
          <th style="background-color:#7fbf7f; width: 20%">TAHAP PENGUASAAN</th>
          <th style="background-color:#7fbf7f; width: 10%">SKOR</th>
          <th style="background-color:#7fbf7f; width: %">KRITERIA</th>
        </tr>
      </thead>
      <tbody>
      	<tr>
      		<td>Menguasai</td>
      		<td>A</td>
      		<td>Boleh melaksanakan aktiviti dengan betul sehingga selesai</td>
      	</tr>
      	<tr>
      		<td>Sedang Menguasai</td>
      		<td>B</td>
      		<td>Memerlukan bimbingan dari semasa apabila melakukan aktiviti namun masih boleh melakukannya sehingga selesai</td>
      	</tr>
      	<tr>
      		<td>Perlu Banyak Bimbingan</td>
      		<td>C</td>
      		<td>Sukar memahami arahan untuk menjalan aktiviti dan seintiasa memerlukan bimbingan</td>
      	</tr>
      </tbody>
     </table>
  </div>
</div>



